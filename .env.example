# Copy to .env (ignored by git) and fill in what you use. Everything has a local default.

# First administrator, created on the first start of an empty installation.
ODDKIN_ADMIN_EMAIL=admin@oddkin.local
ODDKIN_ADMIN_PASSWORD=change-me-at-least-12-chars
ODDKIN_TIMEZONE=America/Campo_Grande

# Public address of the web app: used in e-mailed links and as the allowed origin for uploads.
ODDKIN_PUBLIC_URL=http://127.0.0.1:3000

# A random 32-byte secret that seals invitation and reset tokens until the e-mail is sent.
# Generate one with: openssl rand -hex 16
INVITATION_DELIVERY_KEY=

# E-mail through the real Resend API. Without these, invitations and password
# resets wait in the queue and are sent as soon as the keys are set.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Files. Leave these commented to use the local MinIO that Compose starts.
# For a real Cloudflare R2 bucket:
#   R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   R2_PUBLIC_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   R2_BUCKET=<bucket>
#   R2_ACCESS_KEY_ID=<key id>
#   R2_SECRET_ACCESS_KEY=<secret>
#   R2_PATH_STYLE=false
#   R2_CREATE_BUCKET=false
# The bucket needs a CORS rule allowing PUT/GET from ODDKIN_PUBLIC_URL and exposing the ETag header.
# STORAGE_QUOTA_BYTES=50000000000
